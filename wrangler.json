{
  "name": "nitro-site",
  "main": "./worker-entry.js",
  "compatibility_date": "2026-05-15",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "no_bundle": true,
  "rules": [
    {
      "type": "ESModule",
      "globs": [
        "**/*.js",
        "**/*.mjs"
      ]
    }
  ],
  "assets": {
    "directory": "./dist/client"
  },
  "observability": {
    "enabled": true
  },
  "durable_objects": {
    "bindings": [
      {
        "name": "NITRO_LEADS_STORE",
        "class_name": "NitroLeadsStore"
      }
    ]
  },
  "routes": [
    {
      "pattern": "agencianitro.com.br",
      "custom_domain": true
    },
    {
      "pattern": "www.agencianitro.com.br",
      "custom_domain": true
    }
  ],
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": [
        "NitroLeadsStore"
      ]
    }
  ]
}
